<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>ModelHub.MultiTenancy.EntityFrameworkCore</PackageId>
    <Description>EF Core support for ModelHub.MultiTenancy: one call adds tenant query filters to every tenant entity, and a save interceptor stamps the tenant on new rows and blocks cross-tenant writes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModelHub.MultiTenancy\ModelHub.MultiTenancy.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.23" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
