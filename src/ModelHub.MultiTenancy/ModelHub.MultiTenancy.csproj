<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>ModelHub.MultiTenancy</PackageId>
    <Description>Lightweight, claim-based multi-tenancy for ASP.NET Core: the tenant comes from the signed-in user's token, with optional sub-tenants (e.g. company → branch) and audited platform-admin impersonation.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="ModelHub.MultiTenancy.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
